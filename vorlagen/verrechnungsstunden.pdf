4 0 obj
<< /JS (\nfunction nggT\(s\){ s=String\(s\).replace\(/\\s*uhr\\s*$/i,""\).replace\(/^\\s+|\\s+$/g,""\); if\(!s\) return null;\n  var m=s.match\(/^\(\\d{1,2}\)\(?:[:.,h]\(\\d{2}\)\)?$/\); if\(!m\) m=s.match\(/^\(\\d{1,2}\)\(\\d{2}\)$/\);\n  if\(!m\) return null; var h=+m[1], mi=m[2]?+m[2]:0; if\(h>24||mi>59\) return null; return h*60+mi; }\nfunction nggD\(s\){ s=String\(s\).replace\(/^\\s+|\\s+$/g,""\); if\(!s\) return 0; var neg=0;\n  if\(s.charAt\(0\)=="-"\){neg=1; s=s.substring\(1\);} var m=s.match\(/^\(\\d+\):\(\\d{2}\)$/\), v;\n  if\(m\) v=\(+m[1]\)*60+\(+m[2]\); else { v=parseFloat\(s.replace\(",","."\)\); v=isNaN\(v\)?0:Math.round\(v*60\); }\n  return neg?-v:v; }\nfunction nggF\(min\){ if\(!min\) return ""; var neg=min<0; min=Math.abs\(min\);\n  return \(neg?"-":""\)+Math.floor\(min/60\)+":"+\("0"+\(min%60\)\).slice\(-2\); }\nfunction nggRow\(i\){ var a=nggT\(this.getField\("von_"+i\).valueAsString\), b=nggT\(this.getField\("bis_"+i\).valueAsString\);\n  if\(a!==null && b!==null\){ var d=b-a; if\(d<0\) d+=1440; event.value=nggF\(d\); } }\nfunction nggSum\(prefix,n\){ var s=0; for\(var i=1;i<=n;i++\){ var f=this.getField\(prefix+i\); if\(f\) s+=nggD\(f.valueAsString\); } event.value=nggF\(s\); }\nfunction nggNet\(i\){ var d=this.getField\("dauer_"+i\).valueAsString;\n  event.value = d ? nggF\(nggD\(d\)-nggD\(this.getField\("abzug_"+i\).valueAsString\)\) : ""; }\nfunction nggPrint\(\){ this.print\({bUI:true, bSilent:false, bShrinkToFit:true}\); }\nfunction nggSaveAs\(\){ try { app.execMenuItem\("SaveAs"\); }\n  catch\(e\){ app.alert\("Bitte über Datei > Speichern unter\203 unter einem neuen Namen speichern.",3\); } }\nfunction nggClear\(\){ if\(app.alert\("Alle Eingaben in diesem Formular löschen?",2,2,"Eingaben löschen"\)==4\) this.resetForm\(\); }\n) /S /JavaScript >>
endobj
